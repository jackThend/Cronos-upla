# Conexion a SQL Server
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_DATABASE=

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Firma de sesiones: minimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_SESION=

# Cifrado de las API keys de IA: exactamente 64 caracteres hexadecimales.
# Generar con el mismo comando. Si lo cambias, las claves guardadas dejan de funcionar.
CLAVE_CIFRADO_IA=
